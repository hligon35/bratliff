# Public site settings
SITE_URL=https://alphazonelabs.com/jackrabbit
PUBLIC_API_URL=https://api.example.com
PUBLIC_ADMIN_URL=https://admin.example.com
CORS_ORIGIN=https://alphazonelabs.com

# Admin access
ADMIN_NOTIFICATION_EMAIL=Publisher@JackrabbitPunkinPublishing.com
ADMIN_BOOTSTRAP_EMAILS=publisher@your-google-account.com
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
POLICY_AUD=replace-with-access-audience

# Store + newsletter behavior
STRIPE_CURRENCY=usd
ORDER_SUCCESS_URL=https://alphazonelabs.com/jackrabbit/books.html?checkout=success
ORDER_CANCEL_URL=https://alphazonelabs.com/jackrabbit/books.html?checkout=cancelled
SHEETS_EXPORT_SPREADSHEET_ID=
SHEETS_EXPORT_ENABLED=false

# Secret values: keep these out of frontend code and configure them in Cloudflare.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_APPS_SCRIPT_EMAIL_URL=
GOOGLE_APPS_SCRIPT_EMAIL_SECRET=
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com

# Optional fallback if you want the Worker to send directly instead of relaying through Apps Script.
# Leave blank when using Apps Script for branded email delivery.

# Optional transition-only fallback while Cloudflare is being deployed for public forms/store only.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
GOOGLE_APPS_SCRIPT_ADMIN_URL=