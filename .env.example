# Public site settings
SITE_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example
PUBLIC_ADMIN_URL=https://your-domain.example/admin/
CORS_ORIGIN=https://your-domain.example

# Public Square checkout links (leave blank until JPP supplies each URL)
SQUARE_BATTLES_HARDCOVER_URL=
SQUARE_BATTLES_PAPERBACK_URL=
SQUARE_PAGE_PAL_URL=
SQUARE_CHAPTER_CHAMPION_URL=
SQUARE_BOOKSHELF_BUILDER_URL=
SQUARE_LITERACY_TRAILBLAZER_URL=

# Admin access
ADMIN_NOTIFICATION_EMAIL=publisher@your-domain.example
ADMIN_BOOTSTRAP_EMAILS=publisher@your-google-account.com
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# Store + newsletter behavior
STRIPE_CURRENCY=usd
ORDER_SUCCESS_URL=https://your-domain.example/books.html?checkout=success
ORDER_CANCEL_URL=https://your-domain.example/books.html?checkout=cancelled

# Turnstile (public site key ships to the browser; secret key stays server-side)
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Secret values: keep these out of frontend code and configure them in Cloudflare.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@your-domain.example
