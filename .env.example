# Public site settings
SITE_URL=https://alphazonelabs.com/jackrabbit
GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_ADMIN_URL=

# Google Apps Script deployment settings
GOOGLE_SPREADSHEET_ID=your-google-sheet-id
ADMIN_NOTIFICATION_EMAIL=Publisher@JackrabbitPunkinPublishing.com
GOOGLE_APPS_SENDER_NAME=Jackrabbit Punkin Publishing LLC
ADMIN_ALLOWED_EMAILS=publisher@your-google-account.com

# Secret value for newsletter unsubscribe signing.
# Keep this out of the frontend and store it in Apps Script Script Properties as UNSUBSCRIBE_SECRET.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string