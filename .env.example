# Public site settings
SITE_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example
PUBLIC_ADMIN_URL=https://your-domain.example/admin/
CORS_ORIGIN=https://your-domain.example

# Public Square sponsorship links (legacy/static fallback; superseded by the
# dynamic /api/sponsors/checkout flow, safe to leave blank)
SQUARE_PAGE_PAL_URL=
SQUARE_CHAPTER_CHAMPION_URL=
SQUARE_BOOKSHELF_BUILDER_URL=
SQUARE_LITERACY_TRAILBLAZER_URL=

# Worker Square environment. The default deployment is production; deploy the
# named Wrangler sandbox environment with separate Square sandbox secrets.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_LOCATION_ID=
# Server-side Stripe secret used only to mirror bookstore stock to Stripe product metadata.
STRIPE_SECRET_KEY=

# Admin access
ADMIN_NOTIFICATION_EMAIL=publisher@your-domain.example
ADMIN_BOOTSTRAP_EMAILS=publisher@your-google-account.com
# Developer access excludes owner-only admin permission changes.
ADMIN_DEVELOPER_EMAILS=hligon@getsparqd.com
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# Production uses Cloudflare Access with Google IDP. Sandbox may use direct Google.
ADMIN_AUTH_MODE=access
# Protect /admin/* and /api/admin/* on the canonical host in Zero Trust.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Turnstile (public site key ships to the browser; secret key stays server-side)
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Secret values: keep these out of frontend code and configure them in Cloudflare.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
CUSTOMER_SESSION_SECRET=replace-with-a-different-long-random-string
RESEND_API_KEY=
MAIL_FROM_EMAIL=publisher@jackrabbitpunkinpublishing.com

# Launch stays closed until the acceptance checklist is complete.
SITE_LAUNCH_STATE=closed
# Explicit store tax policy: unconfigured disables native checkout. none requires
# business review; fixed is only for an approved uniform rate (not nexus detection).
STORE_TAX_MODE=unconfigured
STORE_TAX_PERCENTAGE=
STORE_TAX_SHIPPING=false
# Private Email password is a Worker secret, never public configuration.
NAMECHEAP_EMAIL_ADDRESS=publisher@your-domain.example
NAMECHEAP_EMAIL_PASSWORD=
